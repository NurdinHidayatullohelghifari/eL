if PROJECT_DIR not in sys.path:
    sys.path.insert(0, PROJECT_DIR)

# Memuat .env privat sebelum mengimpor aplikasi. Jangan simpan .env di GitHub.
try:
    from dotenv import load_dotenv
    load_dotenv(os.path.join(PROJECT_DIR, ".env"), override=False)
    load_dotenv(os.path.expanduser("~/.env"), override=False)
except ImportError:
    pass

